# Rostra API configuration. Copy to .env for local development.

ENVIRONMENT=development            # "production" turns off demo seed data and /docs and enforces the checks below

# Database. Local Postgres, a Neon connection string, or SQLite for quick tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rostra
# DATABASE_URL=sqlite+aiosqlite:///./rostra.db
# Neon: paste the connection string as is (sslmode / channel_binding are handled).

# Auth. In production this MUST be a random value of 32+ characters or the API refuses to start.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-for-local-dev-only
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=60

# First platform owner. Created on startup when no SUPER_ADMIN exists. Never resets an existing password.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email (Resend). Optional: without a key the API logs instead of sending.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Where the web app lives. Used for CORS and for links in emails. No "*" in production.
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
